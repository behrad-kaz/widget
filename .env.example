# ============================================================
# نمونه فایل محیطی - کپی کنید و نام آن را .env بگذارید
# ============================================================

# ============================================================
# 1. تنظیمات اصلی API
# ============================================================

# آدرس بک‌اند (برای توسعه)
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000

# آدرس بک‌اند (برای تولید)
# NEXT_PUBLIC_API_BASE_URL=https://api.yourdomain.com


# ============================================================
# 2. تنظیمات Socket.io
# ============================================================

NEXT_PUBLIC_SOCKET_URL=http://localhost:3000


# ============================================================
# 3. تنظیمات دیباگ
# ============================================================

NEXT_PUBLIC_DEBUG=true
NEXT_PUBLIC_LOG_LEVEL=debug
NEXT_PUBLIC_SHOW_CONFIG_IN_CONSOLE=true


# ============================================================
# 4. تنظیمات پیش‌فرض ویجت
# ============================================================

NEXT_PUBLIC_DEFAULT_WORKSPACE_ID=1
NEXT_PUBLIC_DEFAULT_PRIMARY_COLOR=#14b8a6
NEXT_PUBLIC_DEFAULT_BUTTON_POSITION=bottom-right
NEXT_PUBLIC_DEFAULT_BUTTON_SIZE=md
NEXT_PUBLIC_DEFAULT_COMPANY_NAME=پشتیبان‌یار
NEXT_PUBLIC_DEFAULT_BUTTON_TEXT=گفتگو با پشتیبانی